# DataWeaver (DW) — Backend

## App
APP_NAME="DataWeaver (DW)"
DEBUG=true
API_VERSION="v1"

## Database
DATABASE_URL="sqlite+aiosqlite:///./data/app.db"

## Storage
PARQUET_STORAGE_PATH="./data/parquets"
MAX_UPLOAD_SIZE_MB=2048
CHUNK_SIZE_BYTES=5242880

## Auth
JWT_SECRET="change-me-to-a-random-secret-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRY_HOURS=24
OAUTH_GOOGLE_CLIENT_ID=""
OAUTH_GOOGLE_CLIENT_SECRET=""
OAUTH_GITHUB_CLIENT_ID=""
OAUTH_GITHUB_CLIENT_SECRET=""

## Encryption (for API key storage)
ENCRYPTION_KEY="change-me-to-a-32-byte-key-in-production"

## CORS
ALLOWED_ORIGINS='["http://localhost:3000"]'

## LLM (user provides their own key via settings UI)
# These are defaults — users override via the settings page
DEFAULT_LLM_PROVIDER="openai"
OPENAI_API_KEY=""
